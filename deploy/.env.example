# Copy to deploy/.env and put real values in. deploy/.env is never committed.

# Postgres. Compose refuses to start without it.
POSTGRES_PASSWORD=

# Grafana admin. Compose refuses to start without it.
GRAFANA_PASSWORD=

# Which address the data ports listen on. Leave as is unless you know why.
# 127.0.0.1 means only this machine can reach Postgres, Kafka and Redis.
RTAT_BIND=127.0.0.1

# Keycloak admin. Compose refuses to start without it.
KEYCLOAK_PASSWORD=
